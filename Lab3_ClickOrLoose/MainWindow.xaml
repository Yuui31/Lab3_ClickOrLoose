<Window x:Class="Lab3_ClickOrLoose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3_ClickOrLoose"
        mc:Ignorable="d"
        Title="ClickOrLoose" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="StartButton" Content="Start" Width="100" Height="30" Click="StartButton_Click"/>
            <TextBlock Text="Score: " Margin="20,0,0,0" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock x:Name="ScoreText" Text="0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Time: " Margin="40,0,0,0" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock x:Name="TimeText" Text="0.0s" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <Canvas x:Name="GameCanvas" Grid.Row="1" Background="#F0F0F0" 
                MouseLeftButtonDown="GameCanvas_MouseLeftButtonDown"/>
    </Grid>
</Window>